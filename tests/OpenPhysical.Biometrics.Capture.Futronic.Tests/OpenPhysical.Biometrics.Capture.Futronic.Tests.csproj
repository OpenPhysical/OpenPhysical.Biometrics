<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsTestProject>true</IsTestProject>
        <IsPackable>false</IsPackable>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../../src/OpenPhysical.Biometrics.Capture.Futronic/OpenPhysical.Biometrics.Capture.Futronic.csproj" />
        <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.1" />
        <PackageReference Include="NUnit" Version="4.4.0" />
        <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
        <PackageReference
            Include="OpenPhysical.Biometrics.TestFixtures"
            Version="1.0.0-dev.20261116.1"
            GeneratePathProperty="true"
            PrivateAssets="all"
        />
    </ItemGroup>
    <ItemGroup>
        <None Update="Fixtures/fs50-geometry-v1.json" CopyToOutputDirectory="PreserveNewest" />
        <None
            Update="Fixtures/fs50-resampler-half128-v1.json"
            CopyToOutputDirectory="PreserveNewest"
        />
        <None Update="Fixtures/hardware-fs50-20261110/**" CopyToOutputDirectory="PreserveNewest" />
        <Content
            Include="$(PkgOpenPhysical_Biometrics_TestFixtures)/fixtures/nbis/tests/fixtures/sd04/*.gray8;$(PkgOpenPhysical_Biometrics_TestFixtures)/fixtures/nbis/tests/fixtures/sd04/manifest.json"
            Link="Fixtures/sd04/%(Filename)%(Extension)"
            CopyToOutputDirectory="PreserveNewest"
        />
    </ItemGroup>
    <PropertyGroup>
        <ScriptedUsbFileName Condition="$([MSBuild]::IsOSPlatform('OSX'))"
            >libscripted_libusb.dylib</ScriptedUsbFileName>
        <ScriptedUsbFileName Condition="$([MSBuild]::IsOSPlatform('Linux'))"
            >libscripted_libusb.so</ScriptedUsbFileName>
        <ScriptedUsbFileName Condition="$([MSBuild]::IsOSPlatform('Windows'))"
            >scripted_libusb.dll</ScriptedUsbFileName>
    </PropertyGroup>
    <Target
        Name="BuildScriptedUsbFixture"
        AfterTargets="Build"
        Inputs="Fixtures/scripted-libusb/scripted-libusb.c;Fixtures/scripted-libusb/CMakeLists.txt"
        Outputs="$(TargetDir)$(ScriptedUsbFileName)"
    >
        <Exec Command="cmake -S &quot;$(MSBuildProjectDirectory)/Fixtures/scripted-libusb&quot; -B &quot;$(IntermediateOutputPath)scripted-usb&quot; -DCMAKE_BUILD_TYPE=Release -DCMAKE_LIBRARY_OUTPUT_DIRECTORY=&quot;$(TargetDir)&quot; -DCMAKE_RUNTIME_OUTPUT_DIRECTORY=&quot;$(TargetDir)&quot; -DCMAKE_LIBRARY_OUTPUT_DIRECTORY_RELEASE=&quot;$(TargetDir)&quot; -DCMAKE_RUNTIME_OUTPUT_DIRECTORY_RELEASE=&quot;$(TargetDir)&quot;" />
        <Exec Command="cmake --build &quot;$(IntermediateOutputPath)scripted-usb&quot; --config Release" />
    </Target>
</Project>
