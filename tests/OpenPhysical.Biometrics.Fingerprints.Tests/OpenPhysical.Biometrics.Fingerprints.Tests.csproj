<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsTestProject>true</IsTestProject>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../../src/OpenPhysical.Biometrics.Fingerprints/OpenPhysical.Biometrics.Fingerprints.csproj" />
        <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.1" />
        <PackageReference Include="NUnit" Version="4.4.0" />
        <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
        <PackageReference
            Include="OpenPhysical.Biometrics.TestFixtures"
            Version="1.0.0-dev.20261116.1"
            GeneratePathProperty="true"
            PrivateAssets="all"
        />
    </ItemGroup>
    <ItemGroup>
        <Content
            Include="$(PkgOpenPhysical_Biometrics_TestFixtures)/fixtures/nbis/tests/fixtures/sd04/*.gray8;$(PkgOpenPhysical_Biometrics_TestFixtures)/fixtures/nbis/tests/fixtures/sd04/manifest.json"
            Link="Fixtures/sd04/%(Filename)%(Extension)"
            CopyToOutputDirectory="PreserveNewest"
        />
    </ItemGroup>
</Project>
