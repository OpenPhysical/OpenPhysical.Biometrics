<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <PackageId>OpenPhysical.Biometrics.TestFixtures</PackageId>
        <PackageVersion>1.0.0-dev.20261116.1</PackageVersion>
        <Title>OpenPhysical Biometrics Test Fixtures</Title>
        <Description>Test-only NIST fingerprint fixtures and the SD04 test helper.</Description>
        <Authors>OpenPhysical Contributors</Authors>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>test-only;fixtures;biometrics;NIST</PackageTags>
        <PackageIcon />
        <IsPackable>true</IsPackable>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <Version>1.0.0-dev.20261116.1</Version>
    </PropertyGroup>
    <ItemGroup>
        <None Remove="@(None)" />
        <Compile Remove="fixtures/**/*.cs" />
        <Content Include="fixtures/**/*" Pack="true" PackagePath="%(Identity)" />
        <Content Include="LICENSE" Pack="true" PackagePath="" />
        <Content
            Include="licenses/**/*"
            Pack="true"
            PackagePath="licenses/%(RecursiveDir)%(Filename)%(Extension)"
        />
        <Content Include="README.md" Pack="true" PackagePath="" />
        <Content Include="THIRD_PARTY_NOTICES.md" Pack="true" PackagePath="" />
        <Content Include="provenance.json" Pack="true" PackagePath="" />
    </ItemGroup>
</Project>
