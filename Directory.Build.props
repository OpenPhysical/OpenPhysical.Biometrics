<Project>
    <PropertyGroup>
        <LangVersion>12.0</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <RunAnalyzers>true</RunAnalyzers>
        <RunAnalyzersDuringBuild>true</RunAnalyzersDuringBuild>
        <AnalysisLevel>latest</AnalysisLevel>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- NuGet Package Metadata -->
        <Authors>OpenPhysical Contributors</Authors>
        <Company>OpenPhysical</Company>
        <Product>OpenPhysical Biometrics</Product>
        <Copyright>Copyright © 2024 OpenPhysical Contributors</Copyright>
        <PackageLicenseFile>LICENSE-PACKAGE</PackageLicenseFile>
        <PackageProjectUrl>https://github.com/OpenPhysical/OpenPhysical.Biometrics</PackageProjectUrl>
        <RepositoryUrl>https://github.com/OpenPhysical/OpenPhysical.Biometrics</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>biometrics;piv;cbeff;fingerprint;nbis;nfiq;facial;jpeg2000</PackageTags>
        <PackageIcon>icon.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <Version>3.0.0-beta.1</Version>
        <NbisPackageVersion>0.1.0-beta.1</NbisPackageVersion>
        <NfiqPackageVersion>0.1.0-beta.1</NfiqPackageVersion>
        <!-- Build Output -->
        <BaseOutputPath>$(MSBuildThisFileDirectory)artifacts\bin\$(MSBuildProjectName)\</BaseOutputPath>
        <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)artifacts\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
        <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts\packages\</PackageOutputPath>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <Optimize>true</Optimize>
        <DebugType>portable</DebugType>
        <DebugSymbols>true</DebugSymbols>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="PolySharp" Version="1.14.1">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>
    <ItemGroup Condition="'$(IsTestProject)' == 'true'">
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
        <PackageReference Include="NSubstitute" Version="5.1.0" />
        <PackageReference Include="coverlet.collector" Version="6.0.0">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>
    <!-- Include package icon in all projects for NuGet packaging -->
    <ItemGroup>
        <None
            Include="$(MSBuildThisFileDirectory)assets/icon.png"
            Pack="true"
            PackagePath=""
            Condition="Exists('$(MSBuildThisFileDirectory)assets/icon.png')"
        />
    </ItemGroup>
    <ItemGroup>
        <None
            Include="$(MSBuildThisFileDirectory)README.md"
            Pack="true"
            PackagePath=""
            Condition="Exists('$(MSBuildThisFileDirectory)README.md')"
        />
    </ItemGroup>
    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'OpenPhysical.Biometrics.Onnx' or '$(MSBuildProjectName)' == 'OpenPhysical.Biometrics' or '$(MSBuildProjectName)' == 'OpenPhysical.Biometrics.Examples' or '$(MSBuildProjectName)' == 'OpenPhysical.Biometrics.Facial' or '$(MSBuildProjectName)' == 'OpenPhysical.Biometrics.Facial.Tests' or '$(MSBuildProjectName)' == 'OpenPhysical.Biometrics.Tool' or '$(MSBuildProjectName)' == 'OpenPhysical.Biometrics.Imaging' or '$(MSBuildProjectName)' == 'OpenPhysical.Biometrics.Imaging.Tests' or '$(MSBuildProjectName)' == 'OpenPhysical.Biometrics.Formats' or '$(MSBuildProjectName)' == 'OpenPhysical.Biometrics.Piv' or '$(MSBuildProjectName)' == 'OpenPhysical.Biometrics.Fingerprints' or '$(MSBuildProjectName)' == 'OpenPhysical.Biometrics.Formats.Tests' or '$(MSBuildProjectName)' == 'OpenPhysical.Biometrics.Piv.Tests' or '$(MSBuildProjectName)' == 'OpenPhysical.Biometrics.Fingerprints.Tests'">
        <IsConsolidatedBiometricsProject>true</IsConsolidatedBiometricsProject>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <RunAnalyzers>true</RunAnalyzers>
        <RunAnalyzersDuringBuild>true</RunAnalyzersDuringBuild>
        <CSharpier_FrameworkVersion>net10.0</CSharpier_FrameworkVersion>
        <Deterministic>true</Deterministic>
    </PropertyGroup>
    <ItemGroup Condition="'$(IsConsolidatedBiometricsProject)' == 'true'">
        <PackageReference Include="CSharpier.MsBuild" Version="1.3.0" PrivateAssets="all" />
        <PackageReference Include="StyleCop.Analyzers" Version="1.3.151-beta" PrivateAssets="all" />
        <AdditionalFiles Include="$(MSBuildThisFileDirectory)stylecop.json" />
    </ItemGroup>
    <ItemGroup>
        <None
            Include="$(MSBuildThisFileDirectory)src/OpenPhysical.Biometrics.Onnx/Resources/LICENSE-MediaPipe-Apache-2.0.txt"
            Pack="true"
            PackagePath="/LICENSE-MediaPipe-Apache-2.0.txt"
            Condition="'$(MSBuildProjectName)' != 'OpenPhysical.Biometrics.Onnx'"
        />
        <None Include="$(MSBuildThisFileDirectory)LICENSE-PACKAGE" Pack="true" PackagePath="/" />
        <None
            Include="$(MSBuildThisFileDirectory)LICENSE-MEDIAPIPE-EXCEPTION"
            Pack="true"
            PackagePath="/"
        />
        <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="/" />
        <None
            Include="$(MSBuildThisFileDirectory)LICENSE-MIT-ORIGINAL"
            Pack="true"
            PackagePath="/"
        />
        <None
            Include="$(MSBuildThisFileDirectory)COMMERCIAL-LICENSING.md"
            Pack="true"
            PackagePath="/"
        />
        <None
            Include="$(MSBuildThisFileDirectory)THIRD_PARTY_NOTICES.md"
            Pack="true"
            PackagePath="/"
        />
    </ItemGroup>
</Project>
