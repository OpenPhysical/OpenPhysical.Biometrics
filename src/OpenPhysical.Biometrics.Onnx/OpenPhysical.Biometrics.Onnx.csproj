<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>OpenPhysical.Biometrics.Onnx</RootNamespace>
        <Description>ONNX models for OpenPhysical Biometrics library</Description>
        <IsPackable>true</IsPackable>
        <PackageId>OpenPhysical.Biometrics.Facial.Models</PackageId>
    </PropertyGroup>
    <ItemGroup>
        <EmbeddedResource Include="Resources\*.onnx" />
        <None Update="Resources/README.md" Pack="true" PackagePath="models/README.md" />
        <None Update="Resources/provenance.json" Pack="true" PackagePath="models/provenance.json" />
        <None
            Update="Resources/LICENSE-MediaPipe-Apache-2.0.txt"
            Pack="true"
            PackagePath="models/LICENSE-MediaPipe-Apache-2.0.txt"
        />
    </ItemGroup>
</Project>
