<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Description>Infrastructure implementation for OpenPhysical Biometrics library</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\OpenPhysical.Biometrics.Core\OpenPhysical.Biometrics.Core.csproj" />
    <ProjectReference Include="..\OpenPhysical.Biometrics.Onnx\OpenPhysical.Biometrics.Onnx.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.7" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="9.0.7" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="9.0.7" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="9.0.7" />
    <PackageReference Include="MetadataExtractor" Version="2.8.1" />
    <PackageReference Update="PolySharp" Version="1.15.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
    <PackageReference Include="CoreJ2K" Version="1.1.2.50" />
    <PackageReference Include="CoreJ2K.ImageSharp" Version="1.0.1" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="OpenPhysical.Biometrics.Infrastructure.Tests" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Certificates\Resources\*.crt" />
  </ItemGroup>
</Project>
