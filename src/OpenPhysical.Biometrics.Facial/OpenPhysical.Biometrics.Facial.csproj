<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>true</IsPackable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <Description>Facial capture preparation and PIV facial records using standard .NET contracts.</Description>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="CSharpFunctionalExtensions" Version="3.7.0" />
        <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
        <ProjectReference Include="../OpenPhysical.Biometrics.Onnx/OpenPhysical.Biometrics.Onnx.csproj" />
        <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
        <ProjectReference Include="../OpenPhysical.Biometrics.Piv/OpenPhysical.Biometrics.Piv.csproj" />
        <ProjectReference Include="../OpenPhysical.Biometrics.Imaging/OpenPhysical.Biometrics.Imaging.csproj" />
        <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.1" />
        <PackageReference Include="CoreJ2K.Skia" Version="2.4.1.108" />
        <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.4" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
        <PackageReference
            Include="Microsoft.Extensions.DependencyInjection.Abstractions"
            Version="10.0.0"
        />
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Include="Pose/GoogleCanonicalFace.csv" />
        <None
            Update="Notices/Google-Face-Geometry-Apache-2.0.txt"
            Pack="true"
            PackagePath="licenses/"
            CopyToOutputDirectory="PreserveNewest"
        />
        <None
            Update="Notices/MathNet.Numerics-5.0.0-MIT.txt"
            Pack="true"
            PackagePath="licenses/"
            CopyToOutputDirectory="PreserveNewest"
        />
        <None
            Update="Notices/FaceOFFx-MIT.txt"
            Pack="true"
            PackagePath="licenses/"
            CopyToOutputDirectory="PreserveNewest"
        />
    </ItemGroup>
</Project>
