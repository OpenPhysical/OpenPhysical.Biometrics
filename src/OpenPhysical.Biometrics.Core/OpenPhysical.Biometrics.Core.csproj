<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Description>Core domain models and abstractions for OpenPhysical Biometrics library</Description>
        <IsPackable>true</IsPackable>
        <PackageId>OpenPhysical.Biometrics.Facial.Core</PackageId>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="CSharpFunctionalExtensions" Version="3.6.0" />
        <PackageReference Include="JetBrains.Annotations" Version="2025.2.0" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.7" />
        <PackageReference Include="Microsoft.Extensions.Options" Version="9.0.7" />
        <PackageReference Update="PolySharp" Version="1.15.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\OpenPhysical.Biometrics.Compatibility\OpenPhysical.Biometrics.Compatibility.csproj" />
        <ProjectReference Include="..\OpenPhysical.Biometrics.Imaging\OpenPhysical.Biometrics.Imaging.csproj" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="OpenPhysical.Biometrics.Core.Tests" />
    </ItemGroup>
</Project>
