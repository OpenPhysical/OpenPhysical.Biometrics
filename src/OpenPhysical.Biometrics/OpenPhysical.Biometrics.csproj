<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <PackageId>OpenPhysical.Biometrics</PackageId>
        <IsPackable>true</IsPackable>
        <Description>Biometric records, structured inspection, PIV preparation, and fingerprint processing for .NET.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../OpenPhysical.Biometrics.Formats/OpenPhysical.Biometrics.Formats.csproj" />
        <ProjectReference Include="../OpenPhysical.Biometrics.Piv/OpenPhysical.Biometrics.Piv.csproj" />
        <ProjectReference Include="../OpenPhysical.Biometrics.Fingerprints/OpenPhysical.Biometrics.Fingerprints.csproj" />
    </ItemGroup>
</Project>
