<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenPhysical.Biometrics.Desktop"
    x:Class="OpenPhysical.Biometrics.Desktop.ImageAdjustmentPanel"
    x:DataType="local:SettingsViewModel"
>
    <StackPanel Width="320" Spacing="12">
        <TextBlock Classes="section" Text="Image adjustments" />
        <local:ImageAdjustmentControls DataContext="{Binding ImageAdjustments}" />
        <TextBlock Classes="caption" Text="{Binding Status}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Save" Command="{Binding SaveCommand}" />
        </StackPanel>
    </StackPanel>
</UserControl>
