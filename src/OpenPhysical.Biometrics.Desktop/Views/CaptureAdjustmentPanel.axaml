<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenPhysical.Biometrics.Desktop"
    x:Class="OpenPhysical.Biometrics.Desktop.CaptureAdjustmentPanel"
    x:DataType="local:CaptureAdjustmentEditorViewModel"
>
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
        <StackPanel Spacing="6">
            <TextBlock Text="{Binding Title}" Classes="section" TextWrapping="Wrap" />
            <TextBlock
                Text="Apply changes, then accept the finger."
                Classes="caption"
                TextWrapping="Wrap"
            />
        </StackPanel>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12">
                <TextBlock
                    Text="{Binding ChangeSummary}"
                    TextWrapping="Wrap"
                    AutomationProperties.LiveSetting="Polite"
                />
                <StackPanel IsEnabled="{Binding CanAdjust}">
                    <local:ImageAdjustmentControls DataContext="{Binding Controls}" />
                </StackPanel>
                <TextBlock
                    Text="Updating preview…"
                    IsVisible="{Binding IsBusy}"
                    Classes="caption"
                />
                <TextBlock
                    Text="{Binding Error}"
                    TextWrapping="Wrap"
                    Classes="caption"
                    AutomationProperties.LiveSetting="Polite"
                />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Spacing="8">
            <WrapPanel HorizontalAlignment="Right">
                <Button Classes="Flat compact" Content="Cancel" Command="{Binding CancelCommand}" />
                <Button Content="Apply changes" Command="{Binding ApplyCommand}" />
            </WrapPanel>
        </StackPanel>
    </Grid>
</UserControl>
