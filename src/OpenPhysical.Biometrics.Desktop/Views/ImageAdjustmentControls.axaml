<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenPhysical.Biometrics.Desktop"
    x:Class="OpenPhysical.Biometrics.Desktop.ImageAdjustmentControls"
    x:DataType="local:ImageAdjustmentViewModel"
>
    <StackPanel Spacing="8">
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Brightness" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding Brightness}" VerticalAlignment="Center" />
        </Grid>
        <Slider
            Minimum="-100"
            Maximum="100"
            TickFrequency="1"
            IsSnapToTickEnabled="True"
            MinHeight="48"
            Value="{Binding Brightness}"
            AutomationProperties.Name="Brightness"
        />
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Contrast" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding Contrast}" VerticalAlignment="Center" />
        </Grid>
        <Slider
            Minimum="0"
            Maximum="100"
            TickFrequency="1"
            IsSnapToTickEnabled="True"
            MinHeight="48"
            Value="{Binding Contrast}"
            AutomationProperties.Name="Contrast"
        />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Classes="Flat" Content="Original" Command="{Binding OriginalCommand}" />
            <Button Classes="Flat" Content="Reset" Command="{Binding ResetCommand}" />
        </StackPanel>
    </StackPanel>
</UserControl>
