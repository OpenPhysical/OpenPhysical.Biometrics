<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenPhysical.Biometrics.Desktop"
    x:Class="OpenPhysical.Biometrics.Desktop.FaceCaptureView"
    x:DataType="local:FaceCaptureViewModel"
>
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
        <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8" IsVisible="{Binding !HasCapture}">
                <ComboBox
                    ItemsSource="{Binding Sources}"
                    SelectedItem="{Binding SelectedSource}"
                    IsEnabled="{Binding !IsBusy}"
                    AutomationProperties.Name="Camera"
                />
                <ComboBox
                    Grid.Column="1"
                    ItemsSource="{Binding Modes}"
                    SelectedItem="{Binding SelectedMode}"
                    IsEnabled="{Binding !IsBusy}"
                    AutomationProperties.Name="Native camera mode"
                />
                <Button
                    Grid.Column="2"
                    Classes="Flat"
                    Content="Refresh"
                    Command="{Binding Actions.CameraRefresh}"
                />
            </Grid>
            <TextBlock
                Text="{Binding Instructions}"
                TextWrapping="Wrap"
                AutomationProperties.LiveSetting="Polite"
            />
            <WrapPanel HorizontalAlignment="Right">
                <CheckBox
                    Content="Auto capture"
                    IsChecked="{Binding $parent[local:EnrollmentView].((local:WorkspaceViewModel)DataContext).Settings.FaceAutoCapture, Mode=TwoWay}"
                    IsVisible="{Binding IsLive}"
                    IsEnabled="{Binding !IsBusy}"
                />
                <CheckBox
                    Content="PIV guides"
                    IsChecked="{Binding Image.ShowPivGuides}"
                    IsVisible="{Binding HasCapture}"
                />
                <CheckBox Content="Face detection" IsChecked="{Binding Image.ShowFaceDetection}" />
                <StackPanel IsVisible="{Binding HasCapture}">
                    <CheckBox
                        Content="Remove background"
                        IsChecked="{Binding $parent[local:EnrollmentView].((local:WorkspaceViewModel)DataContext).Settings.FaceBackgroundReplacement, Mode=TwoWay}"
                        IsVisible="{Binding !Complete}"
                        IsEnabled="{Binding !IsBusy}"
                    />
                </StackPanel>
            </WrapPanel>
        </StackPanel>
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Border
                BorderBrush="{DynamicResource AppDivider}"
                BorderThickness="1"
                ClipToBounds="True"
            >
                <local:FaceImageCanvas
                    Scene="{Binding Image.Scene}"
                    Guides="{Binding Image.ImageGuides}"
                    DetectionGuides="{Binding Image.DetectionGuides}"
                    Mirror="{Binding IsLive}"
                    AutomationProperties.Name="Captured face image"
                />
            </Border>
        </Grid>
        <StackPanel Grid.Row="2" Spacing="8">
            <TextBlock
                Text="{Binding FailureMessage}"
                IsVisible="{Binding HasFailures}"
                Foreground="{DynamicResource AppError}"
                TextWrapping="Wrap"
                AutomationProperties.LiveSetting="Polite"
            />
            <Expander Header="Details" IsVisible="{Binding HasCapture}">
                <TextBlock Text="{Binding Details}" TextWrapping="Wrap" />
            </Expander>
            <CheckBox
                Classes.requiredMissing="{Binding !ReviewConfirmed}"
                IsVisible="{Binding IsReviewing}"
                IsEnabled="{Binding !IsBusy}"
                IsChecked="{Binding ReviewConfirmed}"
            >
                <TextBlock
                    Text="I have reviewed the portrait, lighting, eyes and background."
                    TextWrapping="Wrap"
                />
            </CheckBox>
            <WrapPanel HorizontalAlignment="Right">
                <Button
                    Classes.Flat="{Binding !RequiresRetake}"
                    Content="Retake"
                    Command="{Binding Actions.Retake}"
                    IsVisible="{Binding HasCapture}"
                />
                <Button
                    Classes="Flat"
                    Content="Override failure"
                    Foreground="{DynamicResource AppError}"
                    Command="{Binding Actions.Override}"
                    IsVisible="{Binding CanOverride}"
                />
                <Button
                    Content="Capture face"
                    Command="{Binding Actions.Capture}"
                    IsVisible="{Binding !HasCapture}"
                />
                <Button
                    Content="Accept face"
                    Command="{Binding $parent[local:EnrollmentView].((local:WorkspaceViewModel)DataContext).Export.Enrollment.AcceptCommand}"
                    IsVisible="{Binding IsReviewing}"
                />
            </WrapPanel>
        </StackPanel>
    </Grid>
</UserControl>
