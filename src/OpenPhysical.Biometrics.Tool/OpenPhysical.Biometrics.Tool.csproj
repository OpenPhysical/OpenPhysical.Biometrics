<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <IsPackable>true</IsPackable>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>biotool</ToolCommandName>
        <PackageId>OpenPhysical.Biometrics.Tool</PackageId>
        <Description>Structured biometric record inspection, PIV profile validation, fingerprint template conversion, and MediaPipe portrait preparation.</Description>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="*.cs" />
        <Compile Include="Commands/*.cs" />
        <PackageReference Include="CSharpFunctionalExtensions" Version="3.7.0" />
        <ProjectReference Include="../OpenPhysical.Biometrics.Facial/OpenPhysical.Biometrics.Facial.csproj" />
        <ProjectReference Include="../OpenPhysical.Biometrics.Fingerprints/OpenPhysical.Biometrics.Fingerprints.csproj" />
        <ProjectReference Include="../OpenPhysical.Biometrics.Piv/OpenPhysical.Biometrics.Piv.csproj" />
    </ItemGroup>
    <Target
        Name="ValidateToolRuntimeAssets"
        BeforeTargets="GenerateNuspec"
        Condition="'$(AllowPartialBiometricRuntimes)' != 'true'"
    >
        <ItemGroup>
            <RequiredBiometricRuntime Include="win-x64">
                <Prefix></Prefix>
                <NativeExtension>dll</NativeExtension>
            </RequiredBiometricRuntime>
            <RequiredBiometricRuntime Include="linux-x64;linux-arm64">
                <Prefix>lib</Prefix>
                <NativeExtension>so</NativeExtension>
            </RequiredBiometricRuntime>
            <RequiredBiometricRuntime Include="osx-x64;osx-arm64">
                <Prefix>lib</Prefix>
                <NativeExtension>dylib</NativeExtension>
            </RequiredBiometricRuntime>
        </ItemGroup>
        <Error
            Condition="!Exists('$(NuGetPackageRoot)openphysical.biometrics.nbis/$(NbisPackageVersion)/runtimes/%(RequiredBiometricRuntime.Identity)/native/%(RequiredBiometricRuntime.Prefix)openphysical_nbis.%(RequiredBiometricRuntime.NativeExtension)')"
            Text="The CLI release requires the complete NBIS package, including %(RequiredBiometricRuntime.Identity). For local package verification, set AllowPartialBiometricRuntimes=true."
        />
        <Error
            Condition="!Exists('$(NuGetPackageRoot)openphysical.biometrics.nfiq1/$(NfiqPackageVersion)/runtimes/%(RequiredBiometricRuntime.Identity)/native/%(RequiredBiometricRuntime.Prefix)openphysical_nfiq1.%(RequiredBiometricRuntime.NativeExtension)')"
            Text="The CLI release requires the complete NFIQ1 package, including %(RequiredBiometricRuntime.Identity). For local package verification, set AllowPartialBiometricRuntimes=true."
        />
    </Target>
</Project>
