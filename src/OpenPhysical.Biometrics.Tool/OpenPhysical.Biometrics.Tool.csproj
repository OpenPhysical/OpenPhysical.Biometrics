<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>biometrics</AssemblyName>
    <!-- Only enable PublishSingleFile when actually publishing -->
    <PublishSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <!-- .NET Tool Configuration -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>biometrics</ToolCommandName>
    <PackageOutputPath>./nupkg</PackageOutputPath>
    <!-- NuGet Package Metadata -->
    <PackageId>OpenPhysical.Biometrics.Tool</PackageId>
    <Version>2.1.0</Version>
    <Authors>OpenPhysical Contributors</Authors>
    <Company>OpenPhysical</Company>
    <Product>OpenPhysical Biometrics Tool</Product>
    <Description>Multi-modal biometric processing CLI tool for .NET. Handles facial, fingerprint, and other biometric data with standards compliance including PIV/FIPS 201-3.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/openphysical/biometrics</PackageProjectUrl>
    <RepositoryUrl>https://github.com/openphysical/biometrics</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>piv;facial-recognition;face-detection;biometrics;jpeg2000;fips201;id-card;cli;dotnet-tool</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <Copyright>Copyright © 2025 OpenPhysical Contributors</Copyright>
    <!-- Include models and dependencies in the tool package -->
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>true</IncludeBuildOutput>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\OpenPhysical.Biometrics.Core\OpenPhysical.Biometrics.Core.csproj" />
    <ProjectReference Include="..\OpenPhysical.Biometrics.Infrastructure\OpenPhysical.Biometrics.Infrastructure.csproj" />
    <ProjectReference Include="..\OpenPhysical.Biometrics.Onnx\OpenPhysical.Biometrics.Onnx.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" Version="2025.2.0" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.4" />
    <PackageReference Include="Spectre.Console" Version="0.50.0" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.50.0" />
    <PackageReference
      Include="Spectre.Console.Cli.Extensions.DependencyInjection"
      Version="0.10.1-preview.0.1"
    />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.7" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.7" />
    <PackageReference
      Include="Microsoft.Extensions.Configuration.EnvironmentVariables"
      Version="9.0.7"
    />
    <PackageReference Update="PolySharp" Version="1.15.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
