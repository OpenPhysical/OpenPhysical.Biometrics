<?xml version='1.0' encoding='utf-8'?>
<configuration>
    <packageSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
        <add key="nbis-development" value="../OpenPhysical.Biometrics.NBIS/artifacts/packages" />
        <add key="nfiq-development" value="../OpenPhysical.Biometrics.NFIQ/artifacts/packages" />
    </packageSources>
    <packageSourceMapping>
        <packageSource key="nuget.org">
            <package pattern="*" />
            <package pattern="OpenPhysical.Biometrics.NFIQ2" />
        </packageSource>
        <packageSource key="nbis-development">
            <package pattern="*" />
        </packageSource>
        <packageSource key="nfiq-development">
            <package pattern="*" />
        </packageSource>
    </packageSourceMapping>
</configuration>
