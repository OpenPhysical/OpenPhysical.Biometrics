<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
        <add key="openphysical" value="https://nuget.pkg.github.com/OpenPhysical/index.json" />
    </packageSources>
    <packageSourceMapping>
        <clear />
        <packageSource key="openphysical">
            <package pattern="OpenPhysical.*" />
            <package pattern="Gp4Net" />
        </packageSource>
        <packageSource key="nuget.org">
            <package pattern="OpenPhysical.Biometrics.NBIS" />
            <package pattern="OpenPhysical.Biometrics.NFIQ1" />
            <package pattern="OpenPhysical.Biometrics.NFIQ2" />
            <package pattern="*" />
        </packageSource>
    </packageSourceMapping>
</configuration>
