<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="test-fixtures" value="artifacts/test-feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="openphysical" value="https://nuget.pkg.github.com/OpenPhysical/index.json" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="test-fixtures">
      <package pattern="OpenPhysical.Biometrics.TestFixtures" />
    </packageSource>
    <packageSource key="openphysical">
      <package pattern="OpenPhysical.*" />
      <package pattern="Gp4Net" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
